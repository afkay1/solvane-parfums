# Everything is optional. With no variables set, the store runs in demo mode.

# Your live URL (used for canonical links, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://solvane-parfums.vercel.app

# Long random string used to sign credit codes, gift cards and the admin session
ORDER_SECRET=

# Postgres (Neon). Saves orders, code redemptions, subscribers and messages. Run db/schema.sql once.
DATABASE_URL=
# Password for /admin (required once DATABASE_URL is set)
ADMIN_PASSWORD=

# Stripe Checkout in test mode (sk_test_...). Without it, checkout places demo orders.
STRIPE_SECRET_KEY=

# Resend email (order confirmations, contact form, newsletter welcome)
RESEND_API_KEY=
EMAIL_FROM="Solvane <orders@yourdomain.com>"
ORDERS_INBOX=
CONTACT_INBOX=
